# URL de base de l'API LLM (compatible OpenAI) — doit se terminer par /v1
BASE_URL=https://your-llm-api.example.com/v1

# Clé d'authentification de l'API LLM
API_KEY=your-api-key-here

# Identifiant du modèle à utiliser
MODEL=your-model-id

# URL StreamableHTTP du serveur MCP (optionnel).
# Sans cette variable, le bot fonctionne en mode textuel pur (sans outils géospatiaux).
# MCP_URL=https://geobretagne.fr/mcp/mviewer

# Chemin de base du frontend (doit commencer par /).
# Utilisé par nginx et lors du build Vite.
BASE_PATH=/chat
